{
	"compilerOptions": {
		"module": "commonjs",
		"target": "ES2022",
		"outDir": "dist",
		"lib": ["ES2022"],
		"types": ["node"],
		"sourceMap": true,
		"rootDir": "src",
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true
	},
	"include": ["src"],
	"exclude": ["src/**/tests/**"]
}
